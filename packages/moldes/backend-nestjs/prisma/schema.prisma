// Prisma Schema - Multi-tenant FABRICA-SOFTWARE

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  plan      Plan     @default(FREE)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  agents   Agent[]
  pages    Page[]
  products Product[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String?
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

model Agent {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  systemPrompt String
  model        String   @default("claude-sonnet-4-6")
  tools        String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("agents")
}

model Page {
  id        String   @id @default(cuid())
  tenantId  String
  slug      String
  title     String
  content   Json     @default("{}")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@map("pages")
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("products")
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum UserRole {
  SUPERADMIN
  ADMIN
  VENDOR
  MEMBER
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO E-LEARNING — Cursos, lecciones y progreso de alumnos
// ─────────────────────────────────────────────────────────────────────────────

// Representa un curso publicado dentro de un tenant
// El campo titulo es Json para soporte multilingüe: { "es": "...", "en": "..." }
model Curso {
  id          String    @id @default(cuid())
  tenantId    String
  titulo      Json                         // Multilingüe: { "es": "Título", "en": "Title" }
  instructorId String
  publicado   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lecciones   Leccion[]

  @@index([tenantId])                      // Índice para filtrar por tenant
  @@map("cursos")
}

// Lección individual dentro de un curso
// El orden permite arrastrar-y-soltar en el editor de cursos
model Leccion {
  id        String   @id @default(cuid())
  tenantId  String
  cursoId   String
  titulo    Json                           // Multilingüe: { "es": "...", "en": "..." }
  orden     Int      @default(0)          // Posición de la lección dentro del curso
  duracion  Int      @default(0)          // Duración en segundos para mostrar al alumno

  curso     Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("lecciones")
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO PERIÓDICO DIGITAL — Artículos con flujo editorial
// ─────────────────────────────────────────────────────────────────────────────

// Artículo periodístico con flujo borrador → revisión → publicado
// Soporta múltiples autores por tenant con estados de aprobación
model Articulo {
  id        String          @id @default(cuid())
  tenantId  String
  titulo    Json                            // Multilingüe: { "es": "...", "en": "..." }
  contenido Json                            // Bloques de contenido del editor (Tiptap/Lexical)
  autorId   String
  estado    EstadoArticulo  @default(BORRADOR)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tenantId])
  @@map("articulos")
}

// Estados del flujo editorial del periódico
enum EstadoArticulo {
  BORRADOR   // Redactado pero no enviado a revisión
  REVISION   // Enviado al editor para aprobación
  PUBLICADO  // Visible públicamente en el sitio
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO MAYORISTA B2B — Precios escalonados por volumen
// ─────────────────────────────────────────────────────────────────────────────

// Precio escalonado para compras mayoristas
// Ej: de 10 a 49 unidades = $8.00, de 50 a 99 = $6.50, 100+ = $5.00
model PrecioMayorista {
  id          String  @id @default(cuid())
  tenantId    String
  productoId  String
  cantidadMin Int                          // Cantidad mínima para aplicar este precio
  cantidadMax Int?                         // Cantidad máxima (null = sin límite superior)
  precio      Decimal @db.Decimal(10, 2)
  moneda      String  @default("USD")

  @@index([tenantId])
  @@map("precios_mayoristas")
}

// Registro de clientes aprobados para comprar en modo mayorista
// Requiere aprobación manual del administrador del tenant
model ClienteMayorista {
  id          String  @id @default(cuid())
  tenantId    String
  usuarioId   String  @unique               // Un usuario solo puede ser mayorista una vez
  aprobado    Boolean @default(false)        // El admin debe aprobar manualmente
  limiteMin   Decimal @db.Decimal(10, 2)    // Monto mínimo de compra por orden

  @@index([tenantId])
  @@map("clientes_mayoristas")
}
